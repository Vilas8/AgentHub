# ============================================================
# AgentHub Environment Variables
# ============================================================
# Copy this file to .env and fill in your values.
# Never commit .env to version control.

# --- Application ---
APP_ENV=development
APP_URL=http://localhost:3000
API_URL=http://localhost:8000
SECRET_KEY=change-me-minimum-32-chars-random-secret

# --- Database ---
DATABASE_URL=postgresql+asyncpg://agenthub:agenthub@localhost:5432/agenthub
# For local SQLite dev (no Postgres required):
# DATABASE_URL=sqlite+aiosqlite:///./agenthub_dev.db

# --- Redis ---
REDIS_URL=redis://localhost:6379/0

# --- JWT Authentication ---
JWT_SECRET_KEY=change-me-jwt-secret-minimum-32-chars
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# --- OAuth (optional) ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- AI Providers (configure at least one) ---
GEMINI_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
OLLAMA_BASE_URL=http://localhost:11434

# --- Object Storage ---
S3_ENDPOINT=http://localhost:9000
S3_BUCKET=agenthub
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_REGION=us-east-1

# --- Payments ---
# Set to "simulator" for local development (never use in production)
PAYMENT_PROVIDER=simulator
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# --- Email ---
EMAIL_PROVIDER=console
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=noreply@agenthub.example

# --- Monitoring ---
OTEL_EXPORTER_OTLP_ENDPOINT=
ERROR_TRACKING_DSN=
LOG_LEVEL=INFO

# --- Frontend ---
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_APP_URL=http://localhost:3000
